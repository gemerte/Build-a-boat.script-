-- Таймер: сколько уже автофармит (ВРЕМЯ в таблице), капает каждую секунду пока фарм включён
local function statsFmtHMS(sec)
	local h = math.floor(sec / 3600)
	local m = math.floor((sec % 3600) / 60)
	local s = sec % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%02d:%02d", m, s)
end

local function statsEnsureTimers()
	if STATS_STATE.timersStarted then return end
	STATS_STATE.timersStarted = true
	task.spawn(function()
		while true do
			task.wait(1)
			if goldFarmActive and STATS_STATE.goldPanelRef then
				STATS_STATE.goldFarmSeconds = STATS_STATE.goldFarmSeconds + 1
				local t = statsFmtHMS(STATS_STATE.goldFarmSeconds)
				pcall(function()
					STATS_STATE.goldPanelRef.setTime(1, t)
					STATS_STATE.goldPanelRef.setTime(2, t)
				end)
			end
			if candyFarmActive and STATS_STATE.candyPanelRef then
				STATS_STATE.candyFarmSeconds = STATS_STATE.candyFarmSeconds + 1
				local t = statsFmtHMS(STATS_STATE.candyFarmSeconds)
				pcall(function()
					for i = 1, STATS_STATE.candyRows do
						STATS_STATE.candyPanelRef.setTime(i, t)
					end
				end)
			end
		end
	end)
end

-- Золото: Data.Gold, каждую секунду 3 минуты, показывают С/ и МИН/
local function startGoldStatsWatch()
	if STATS_STATE.goldStarted then return end
	local startVal = statsReadGold()
	if startVal == nil then return end
	STATS_STATE.goldStarted = true
	task.spawn(function()
		local panel = statsMakePanel("золото", {
			{ label = "С/", time = "00:00", value = "..." },
			{ label = "МИН/", time = "00:00", value = "..." },
		})
		STATS_STATE.goldPanelRef = panel
		statsEnsurePill()
		statsEnsureTimers()
		panel.setValue(1, "+0 (ср. 0/сек)")
		panel.setValue(2, "+0/мин")
		local finalVal = startVal
		for i = 1, STATS_DUR do
			task.wait(1)
			local cur = statsReadGold()
			if cur then
				finalVal = cur
				local total = cur - startVal
				local dps = total / i
				panel.setValue(1, "+" .. statsFmtNum(total) .. " (ср. " .. statsFmtNum(dps) .. "/сек)")
				panel.setValue(2, "+" .. statsFmtNum(dps * 60) .. "/мин (прогноз)")
			end
		end
		local total = finalVal - startVal
		local dps = total / STATS_DUR
		panel.setValue(1, "+" .. statsFmtNum(total) .. " (ср. " .. statsFmtNum(dps) .. "/сек)")
		panel.setValue(2, "+" .. statsFmtNum(dps * 60) .. "/мин")
		hubNotify("Замер золота: +" .. statsFmtNum(dps) .. "/сек | +" .. statsFmtNum(dps * 60) .. "/мин", 4)
	end)
end

