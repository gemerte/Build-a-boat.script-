-- ОТ СЕБЯ: авто-noclip тела пока CandyFarm включён — персонаж не застревает в стенах/двери
local candyNoclipConn = nil
local function setCandyNoclip(on)
	if candyNoclipConn then
		candyNoclipConn:Disconnect()
		candyNoclipConn = nil
	end
	if on then
		candyNoclipConn = RunService.Stepped:Connect(function()
			local char = player.Character
			if char then
				for _, p in ipairs(char:GetDescendants()) do
					if p:IsA("BasePart") then p.CanCollide = false end
				end
			end
		end)
	else
		-- вернуть коллизию телу (движок сам пересчитает части персонажа)
		local char = player.Character
		if char then
			for _, p in ipairs(char:GetDescendants()) do
				if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.CanCollide = true end
			end
		end
	end
end

-- Надёжный поиск хэллоуинских домиков: ищем ВСЕ домики TrickOrTreatHouse с Door,
-- чтобы ходить по дверям по кругу (не тпать на одну и ту же дверь подряд)
local candyDoorPrev = nil

local function findCandyHouses()
	local houses = getHousesFolder()
	if not houses then
		return nil, "папки Houses пока нет"
	end
	local children = houses:GetChildren()
	local list = {}
	for _, h in ipairs(children) do
		if h.Name == "TrickOrTreatHouse" and (h:FindFirstChild("Door") or h:FindFirstChild("Door", true)) then
			table.insert(list, h)
		end
	end
	if #list > 0 then
		return list
	end
	local secondHouse = children[2]
	if secondHouse and secondHouse.Name == "TrickOrTreatHouse" and secondHouse:FindFirstChild("Door") then
		return { secondHouse }
	end
	if #children < 2 then
		return nil, "в Houses всего домов: " .. #children
	end
	local names = {}
	for i = 1, math.min(#children, 5) do
		names[i] = children[i].Name
	end
	return nil, "дома не хэллоуин (" .. table.concat(names, ", ") .. ")"
end

local function candyFarmLoop()
	local firstRun = true
	while candyFarmActive do
		local list, why = findCandyHouses()
		local pick = nil
		if list then
			-- идём по кругу: следующая дверь СПИСОКА (если дверь одна — она и придётся),
			-- и никогда не тпаем к той же двери подряд
			local idx = 1
			if candyDoorPrev then
				for i, h in ipairs(list) do
					if h == candyDoorPrev then
						idx = i + 1
						break
					end
				end
				if idx > #list then idx = 1 end
			end
			pick = list[idx]
			candyDoorPrev = pick
		end
		if firstRun then
			firstRun = false
			hubNotify(pick and ("CandyFarm: дверей найдено " .. #list .. " 🎃") or ("CandyFarm: " .. tostring(why)), 3)
			if not pick then
				print("[CandyFarm] не найден дом:", tostring(why))
			end
		end
		if not pick and candyFarmActive then
			-- ещё раз проверяем каждые 5 секунд, чтобы не спамить
			task.wait(5)
		elseif pick then
			local door = pick:FindFirstChild("Door") or pick:FindFirstChild("Door", true)
			if door then
				local doorCFrame = door:GetPivot()
				local rootPart = getCharacterRoot(player)
				if rootPart then
					-- телепорт ТОЛЬКО пользователя скрипта: касание двери
					rootPart.CFrame = doorCFrame + Vector3.new(0, 3, 0)
					task.wait(0.25)
					if not candyFarmActive then break end
					-- подъём на 90 студов выше двери, платформа под ногами (в воздухе, не падает)
					local upCFrame = doorCFrame + Vector3.new(0, 90, 0)
					spawnPlatform(upCFrame)
					rootPart.CFrame = upCFrame
					task.wait(6.5) -- ожидание снижено на 50% (было 13)
				end
			else
				task.wait(1)
			end
		else
			task.wait(1)
		end
	end
end

