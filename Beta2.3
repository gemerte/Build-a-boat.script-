local noirGui = player.PlayerGui:FindFirstChild("NoirUI")
local winFrame = noirGui and noirGui:FindFirstChild("Window")

local bgLayer, bgDim
if winFrame then
	local body = winFrame:FindFirstChild("Body")
	local pagesFrame = body and body:FindFirstChild("Pages")

	if winFrame:FindFirstChild("NoirBG") then winFrame.NoirBG:Destroy() end
	if body and body:FindFirstChild("NoirBG") then body.NoirBG:Destroy() end
	if body and body:FindFirstChild("NoirBGDim") then body.NoirBGDim:Destroy() end

	bgLayer = Instance.new("Frame")
	bgLayer.Name = "NoirBG"
	bgLayer.BackgroundTransparency = 1
	bgLayer.BorderSizePixel = 0
	bgLayer.Size = UDim2.fromScale(1, 1)
	bgLayer.ZIndex = 1
	bgLayer.ClipsDescendants = true
	bgLayer.Parent = body or winFrame

	bgDim = Instance.new("Frame")
	bgDim.Name = "NoirBGDim"
	bgDim.BackgroundColor3 = Color3.new(0, 0, 0)
	bgDim.BackgroundTransparency = 1
	bgDim.BorderSizePixel = 0
	bgDim.Size = UDim2.fromScale(1, 1)
	bgDim.ZIndex = 2
	bgDim.Parent = body or winFrame
end

local currentBg = "None"
local bgStrength = 0.7

local function clearBg()
	if not bgLayer then return end
	for _, c in ipairs(bgLayer:GetChildren()) do
		c:Destroy()
	end
end

local function setContentTransparent(on)
	local body = winFrame and winFrame:FindFirstChild("Body")
	local pagesFrame = body and body:FindFirstChild("Pages")
	if body then
		body.BackgroundTransparency = on and 1 or 0
	end
	if pagesFrame then
		pagesFrame.BackgroundTransparency = on and 1 or 0
	end
end

local function addFull(parent, props)
	local f = Instance.new("Frame")
	f.BackgroundColor3 = props.Color or Color3.new(1, 1, 1)
	f.BackgroundTransparency = props.Transparency or 0
	f.BorderSizePixel = 0
	f.Size = props.Size or UDim2.fromScale(1, 1)
	f.Position = props.Position or UDim2.new()
	f.ZIndex = 1
	f.Parent = parent
	if props.Gradient then
		local g = Instance.new("UIGradient")
		g.Color = props.Gradient
		g.Rotation = props.Rotation or 90
		g.Parent = f
	end
	return f
end

local function buildSoft()
	addFull(bgLayer, {
		Color = Color3.fromRGB(18, 18, 22),
		Transparency = 0,
		Gradient = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(22, 22, 28)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 8, 10)),
		}),
		Rotation = 160,
	})
end

local function buildGrid()
	addFull(bgLayer, { Color = Color3.fromRGB(10, 10, 10), Transparency = 0 })
	for i = 1, 16 do
		local v = Instance.new("Frame")
		v.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		v.BackgroundTransparency = 0.92
		v.BorderSizePixel = 0
		v.Size = UDim2.new(0, 1, 1, 0)
		v.Position = UDim2.fromScale(i / 16, 0)
		v.ZIndex = 1
		v.Parent = bgLayer
	end
	for i = 1, 12 do
		local h = Instance.new("Frame")
		h.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		h.BackgroundTransparency = 0.92
		h.BorderSizePixel = 0
		h.Size = UDim2.new(1, 0, 0, 1)
		h.Position = UDim2.fromScale(0, i / 12)
		h.ZIndex = 1
		h.Parent = bgLayer
	end
end

local function buildScanlines()
	addFull(bgLayer, { Color = Color3.fromRGB(8, 8, 8), Transparency = 0 })
	for i = 0, 90 do
		local line = Instance.new("Frame")
		line.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
		line.BackgroundTransparency = 0.88
		line.BorderSizePixel = 0
		line.Size = UDim2.new(1, 0, 0, 1)
		line.Position = UDim2.fromOffset(0, i * 5)
		line.ZIndex = 1
		line.Parent = bgLayer
	end
end

local function buildGradient()
	addFull(bgLayer, {
		Color = Color3.fromRGB(255, 255, 255),
		Transparency = 0,
		Gradient = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(12, 10, 28)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(40, 18, 70)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(6, 6, 10)),
		}),
		Rotation = 135,
	})
end

local function buildDots()
	addFull(bgLayer, { Color = Color3.fromRGB(9, 9, 9), Transparency = 0 })
	for y = 0, 18 do
		for x = 0, 22 do
			local d = Instance.new("Frame")
			d.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
			d.BackgroundTransparency = 0.84
			d.BorderSizePixel = 0
			d.Size = UDim2.fromOffset(3, 3)
			d.Position = UDim2.new(0, 10 + x * 22, 0, 8 + y * 22)
			d.ZIndex = 1
			d.Parent = bgLayer
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(1, 0)
			c.Parent = d
		end
	end
end

local function buildGold()
	addFull(bgLayer, {
		Color = Color3.fromRGB(255, 255, 255),
		Transparency = 0,
		Gradient = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(18, 14, 8)),
			ColorSequenceKeypoint.new(0.45, Color3.fromRGB(70, 48, 16)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 8, 8)),
		}),
		Rotation = 120,
	})
	for i = 0, 10 do
		local line = Instance.new("Frame")
		line.BackgroundColor3 = Color3.fromRGB(218, 165, 32)
		line.BackgroundTransparency = 0.9
		line.BorderSizePixel = 0
		line.Size = UDim2.new(1, 80, 0, 2)
		line.Rotation = 25
		line.Position = UDim2.fromOffset(-40, i * 42)
		line.ZIndex = 1
		line.Parent = bgLayer
	end
end

local function buildMimi()
	local cols, rows = 4, 3
	for i = 1, cols * rows do
		local r = math.floor((i - 1) / cols)
		local c = (i - 1) % cols
		local img = Instance.new("ImageLabel")
		img.Name = "Mimi"
		img.BackgroundTransparency = 1
		img.BorderSizePixel = 0
		img.Image = MIMI_IDS[((i - 1) % #MIMI_IDS) + 1]
		img.ScaleType = Enum.ScaleType.Crop
		img.Size = UDim2.fromScale(1 / cols, 1 / rows)
		img.Position = UDim2.fromScale(c / cols, r / rows)
		img.ImageTransparency = math.clamp(1 - bgStrength, 0.05, 0.85)
		img.ZIndex = 1
		img.Parent = bgLayer
	end
	pcall(function()
		game:GetService("ContentProvider"):PreloadAsync(MIMI_IDS)
	end)
end

local builders = {
	["None"] = function() end,
	["Soft"] = buildSoft,
	["Grid"] = buildGrid,
	["Scanlines"] = buildScanlines,
	["Gradient"] = buildGradient,
	["Dots"] = buildDots,
	["Gold"] = buildGold,
	["Mimi Typh"] = buildMimi,
}

local function applyBackground(name)
	currentBg = name or "None"
	if not bgLayer then return end
	clearBg()
	if currentBg == "None" then
		setContentTransparent(false)
		bgDim.BackgroundTransparency = 1
		return
	end
	setContentTransparent(true)
	local fn = builders[currentBg]
	if fn then fn() end
	if currentBg == "Mimi Typh" then
		bgDim.BackgroundTransparency = 0.25 + (1 - bgStrength) * 0.5
	else
		bgDim.BackgroundTransparency = 0.35 + (1 - bgStrength) * 0.4
	end
end

