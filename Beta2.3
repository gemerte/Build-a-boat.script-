					elseif opt.GamePassId then
						pcall(function()
							MarketplaceService:PromptGamePassPurchase(player, opt.GamePassId)
						end)
					end
				end)
				return b
			end

			TabApi.CreateButton = TabApi.Button
			TabApi.CreateLabel = TabApi.Label
			TabApi.CreateSlider = TabApi.Slider
			TabApi.CreateDropdown = TabApi.Dropdown
			TabApi.CreateDonate = TabApi.Donate
			TabApi.CreateToggle = TabApi.Toggle
			TabApi.CreateColorPicker = TabApi.ColorPicker
			TabApi.CreateTextBox = TabApi.TextBox
			return TabApi
		end

		WindowApi.CreateTab = WindowApi.Tab
		function WindowApi:Minimize() setMinimized(true) end
		function WindowApi:Maximize() setMaximized(true) end
		function WindowApi:Toggle()
			gui.Enabled = not gui.Enabled
		end
		function WindowApi:SetVisible(v)
			gui.Enabled = v and true or false
		end
		function WindowApi:Destroy()
			for _, fn in ipairs(onUnload) do
				pcall(fn)
			end
			for _, c in ipairs(connections) do
				pcall(function() c:Disconnect() end)
			end
			gui:Destroy()
		end

		local Window = setmetatable({}, {
			__index = function(_, k)
				if k == "Name" then return title.Text end
				return WindowApi[k]
			end,
			__newindex = function(_, k, v)
				if k == "Name" or k == "name" then
					title.Text = tostring(v)
				else
					WindowApi[k] = v
				end
			end,
		})

		return Window
	end

	return Lib
end)()

