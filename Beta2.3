local function startCandyStatsWatch()
	if STATS_STATE.candyStarted then return end
	local d = statsGetData()
	if not d then return end
	local rows = {}
	for i, cn in ipairs(CANDY_STAT) do
		local v = statsReadCandy(cn.key)
		if v ~= nil then
			table.insert(rows, { label = cn.ru, key = cn.key })
		end
	end
	if #rows == 0 then return end
	STATS_STATE.candyStarted = true
	STATS_STATE.candyRows = #rows
	task.spawn(function()
		local panel = statsMakePanel("конфеты", rows)
		STATS_STATE.candyPanelRef = panel
		statsEnsurePill()
		statsEnsureTimers()
		local starts = {}
		for i, cn in ipairs(rows) do
			starts[cn.key] = statsReadCandy(cn.key) or 0
			panel.setValue(i, "+0 " .. cn.label)
		end
		for i = 1, STATS_DUR do
			task.wait(1)
			for j, cn in ipairs(rows) do
				local cur = statsReadCandy(cn.key)
				if cur then
					panel.setValue(j, "+" .. statsFmtNum(cur - starts[cn.key]) .. " " .. cn.label)
				end
			end
		end
		for j, cn in ipairs(rows) do
			local cur = statsReadCandy(cn.key)
			panel.setValue(j, "+" .. statsFmtNum((cur or starts[cn.key]) - starts[cn.key]) .. " " .. cn.label)
		end
		hubNotify("Замер конфет готов (3:00)", 3)
	end)
end

