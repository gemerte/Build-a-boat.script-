local HatVariables = {
	enabled = false, style = "Classic", transparency = 0.3,
	rainbow = false, rainbowSpeed = 5, color = Color3.fromRGB(0, 255, 255),
	radius = 2.4, height = 1.6, reflectance = 0, sides = 25,
	parts = {}, connection = nil,
}
local tau = math.pi * 2
local drawings = {}
local hasDrawing = false
pcall(function()
	local t = Drawing.new("Line")
	t:Remove()
	hasDrawing = true
end)

local function rebuildDrawings(n)
	if hasDrawing then
		for i = 1, #drawings do
			pcall(function() drawings[i][1]:Remove() end)
			pcall(function() drawings[i][2]:Remove() end)
		end
	end
	drawings = {}
	if not hasDrawing then return end
	for i = 1, n do
		local line = Drawing.new("Line")
		local tri = Drawing.new("Triangle")
		line.ZIndex = 2
		line.Thickness = 2
		tri.ZIndex = 1
		tri.Filled = true
		drawings[i] = { line, tri }
	end
end
rebuildDrawings(HatVariables.sides)

