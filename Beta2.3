						code = sessionCode,
						game = "Build a Boat",
						gold = getGold(),
						inventory = getInventory(),
						farm_status = farmStatusText,
					}),
				})
				local res = httpRequest({
					Url = API_URL .. "/api/fetch_cmd" .. sessionCode,
					Method = "GET",
				})
				if res and res.Body then
					local data = HttpService:JSONDecode(res.Body)
					local cmd = data.command
					if cmd and cmd:sub(1, 4) == "BUY_" then
						local itemName = cmd:sub(5)
						pcall(function()
							workspace.ItemBoughtFromShop:InvokeServer(itemName, 1)
						end)
					end
				end
			end)
		end
	end)
	notify("loaded ⚡ BongoS1n BETA 0.3 ⚡ код " .. sessionCode, 5)
else
	notify("loaded ⚡ BongoHub-BaBfT BETA 0.3", 3)
end

