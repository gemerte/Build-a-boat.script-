local function getAliveRoot()
	local char = player.Character
	if not char or not char.Parent then return nil end
	local hum = char:FindFirstChild("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if hum and hum.Health > 0 and root and root.Parent then
		return root
	end
	return nil
end

local function goldFarmLoop()
	farmStatusText = "Running"
	while goldFarmActive do
		local rootPart = getAliveRoot()
		if rootPart then
			for _, point in ipairs(goldFarmPoints) do
				if not goldFarmActive then break end
				-- КАЖДЫЙ шаг берём СВЕЖУЮ ссылку на персонажа (после смерти старая становится мёртвой)
				rootPart = getAliveRoot()
				if not rootPart then break end
				-- телепорт + платформа чуть ниже (игрок в воздухе, не падает)
				spawnPlatform(point)
				pcall(function() rootPart.CFrame = point end)
				task.wait(2)
				fireClaimRiver()
			end
			if goldFarmActive then
				-- ресет игрока; возрождение ускорено до 0.1 сек
				local hum = player.Character and player.Character:FindFirstChild("Humanoid")
				if hum and hum.Health > 0 then hum.Health = 0 end
				pcall(function() player.RespawnTime = 0.1 end)
				pcall(function() Players.RespawnTime = 0.1 end)
				task.wait(1)
				removePlatform()
				-- ЖДЁМ нового ЖИВОГО персонажа (до 15 сек), а не фиксированные пару секунд
				local waited = 0
				while goldFarmActive and waited < 15 do
					task.wait(0.25)
					waited = waited + 0.25
					if getAliveRoot() then break end
				end
				task.wait(0.5)
			end
		else
			-- персонажа нет / он мёртв — ждём респавн и продолжаем
			task.wait(0.5)
		end
	end
	removePlatform()
	farmStatusText = "Stopped"
end

