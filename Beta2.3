-- ПРИВЕТ МЕНЯ ЗОВУТ ДМИТРИЙ Я СОЗДАТЕЛЬ ДАННОГО СКРИПТА Я ЮЗАЮ ИИ ДЛЯ СОЗДАНИЯ СКРИПТОВ
-- МОЙ ТГ BongoS1n
-- =========================================================
-- BongoHub - BaBfT (Build a Boat for Treasure)
-- Все функции скрипта 2 (кроме Auto Farm) + новое:
--   • CandyFarm — телепорт к TrickOrTreatHouse (вкл/выкл)
--   • GoldFarm — река, ClaimRiverResultsGold, с платформой и ресетом
--   • Хэллоуин магазин: JackOLantern / Candle / PineTree
-- Запуск через инжектор. RightShift = открыть/скрыть меню
-- =========================================================

local Noir = (function()
	local Players = game:GetService("Players")
	local UIS = game:GetService("UserInputService")
	local TweenService = game:GetService("TweenService")
	local MarketplaceService = game:GetService("MarketplaceService")
	local RunService = game:GetService("RunService")

	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local T = {
		Bg     = Color3.fromRGB(8, 8, 8),
		Bar    = Color3.fromRGB(12, 12, 12),
		Side   = Color3.fromRGB(10, 10, 10),
		Elem   = Color3.fromRGB(18, 18, 18),
		Hover  = Color3.fromRGB(28, 28, 28),
		Press  = Color3.fromRGB(36, 36, 36),
		Stroke = Color3.fromRGB(32, 32, 32),
		Text   = Color3.fromRGB(235, 235, 235),
		Sub    = Color3.fromRGB(140, 140, 140),
		Accent = Color3.fromRGB(255, 255, 255),
		MinW   = 380,
		MinH   = 260,
		BarH   = 38,
		SideW  = 128,
		Anim   = TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
	}

	local Lib = {}

	local function corner(inst, r)
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, r or 6)
		c.Parent = inst
		return c
	end

	local function stroke(inst, col, th)
		local s = Instance.new("UIStroke")
		s.Color = col or T.Stroke
		s.Thickness = th or 1
		s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		s.Parent = inst
		return s
	end

	local function pad(inst, l, r, t, b)
		local p = Instance.new("UIPadding")
		p.PaddingLeft = UDim.new(0, l or 0)
		p.PaddingRight = UDim.new(0, r or 0)
		p.PaddingTop = UDim.new(0, t or 0)
		p.PaddingBottom = UDim.new(0, b or 0)
		p.Parent = inst
		return p
	end

	local function tween(inst, props, info)
		local tw = TweenService:Create(inst, info or T.Anim, props)
		tw:Play()
		return tw
	end

	local function runScript(src, extra)
		if src == nil or src == "" then return end
		extra = extra or {}
		if type(src) == "function" then
			task.spawn(src, extra.Value, extra)
			return
		end
		if type(src) == "string" then
			if not loadstring then return end
			local code = extra.Value ~= nil and ("local Value = ...\n" .. src) or src
			local fn, err = loadstring(code)
			if not fn then
				warn("[NOIR] SCRIPT error:", err)
				return
			end
			task.spawn(fn, extra.Value)
		end
	end

	local function hover(btn, from, to)
		btn.MouseEnter:Connect(function()
			tween(btn, { BackgroundColor3 = to }, TweenInfo.new(0.12))
		end)
		btn.MouseLeave:Connect(function()
			tween(btn, { BackgroundColor3 = from }, TweenInfo.new(0.12))
		end)
	end

	local function textBtn(parent, props)
		local b = Instance.new("TextButton")
		b.AutoButtonColor = false
		b.Font = Enum.Font.GothamMedium
		b.TextSize = props.TextSize or 13
		b.TextColor3 = props.TextColor3 or T.Text
		b.BackgroundColor3 = props.BackgroundColor3 or T.Elem
		b.BorderSizePixel = 0
		b.Text = props.Text or ""
		b.Size = props.Size or UDim2.new(1, 0, 0, 32)
		b.Position = props.Position or UDim2.new()
		b.TextXAlignment = props.Align or Enum.TextXAlignment.Center
		b.Parent = parent
		if props.Corner then corner(b, props.Corner) end
		return b
	end

	function Lib.CreateWindow(cfg)
		cfg = cfg or {}
		local initName = tostring(cfg.Name or cfg.name or "NOIR")
		local initSize = cfg.Size or Vector2.new(560, 420)
		local minSize = cfg.MinSize or Vector2.new(T.MinW, T.MinH)
		if cfg.Accent then T.Accent = cfg.Accent end

		local connections = {}
		local function bind(sig, fn)
			local c = sig:Connect(fn)
			table.insert(connections, c)
			return c
		end

		local gui = Instance.new("ScreenGui")
		gui.Name = "NoirUI"
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = true
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		gui.Parent = playerGui

		local window = Instance.new("Frame")
		window.Name = "Window"
		window.Size = UDim2.fromOffset(initSize.X, initSize.Y)
		window.Position = UDim2.new(0.5, -initSize.X / 2, 0.5, -initSize.Y / 2)
		window.BackgroundColor3 = T.Bg
		window.BorderSizePixel = 0
		window.ClipsDescendants = true
		window.Active = true
		window.Parent = gui
		corner(window, 8)
		stroke(window, T.Stroke, 1)

		local shadow = Instance.new("ImageLabel")
		shadow.BackgroundTransparency = 1
		shadow.Image = "rbxassetid://1316045217"
		shadow.ImageColor3 = Color3.new(0, 0, 0)
		shadow.ImageTransparency = 0.45
		shadow.ScaleType = Enum.ScaleType.Slice
		shadow.SliceCenter = Rect.new(10, 10, 118, 118)
		shadow.Size = UDim2.new(1, 40, 1, 40)
		shadow.Position = UDim2.fromOffset(-20, -16)
		shadow.ZIndex = 0
		shadow.Parent = window

		local bar = Instance.new("Frame")
		bar.Name = "TitleBar"
		bar.Size = UDim2.new(1, 0, 0, T.BarH)
		bar.BackgroundColor3 = T.Bar
		bar.BorderSizePixel = 0
		bar.ZIndex = 5
		bar.Parent = window
		corner(bar, 8)

		local barFix = Instance.new("Frame")
		barFix.BackgroundColor3 = T.Bar
		barFix.BorderSizePixel = 0
		barFix.Size = UDim2.new(1, 0, 0, 12)
		barFix.Position = UDim2.new(0, 0, 1, -12)
		barFix.ZIndex = 5
		barFix.Parent = bar

		local accentLine = Instance.new("Frame")
		accentLine.BackgroundColor3 = T.Accent
		accentLine.BackgroundTransparency = 0.85
		accentLine.BorderSizePixel = 0
		accentLine.Size = UDim2.new(1, 0, 0, 1)
		accentLine.Position = UDim2.new(0, 0, 1, 0)
		accentLine.ZIndex = 6
		accentLine.Parent = bar

		local title = Instance.new("TextLabel")
		title.BackgroundTransparency = 1
		title.Size = UDim2.new(1, -120, 1, 0)
		title.Position = UDim2.fromOffset(14, 0)
		title.Font = Enum.Font.GothamBold
		title.TextSize = 14
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.TextColor3 = T.Text
		title.Text = initName
		title.ZIndex = 6
		title.Parent = bar

		local function winBtn(txt, xOff)
			local b = Instance.new("TextButton")
			b.AutoButtonColor = false
			b.Size = UDim2.fromOffset(36, T.BarH)
			b.Position = UDim2.new(1, xOff, 0, 0)
			b.BackgroundColor3 = T.Bar
			b.BorderSizePixel = 0
			b.Text = txt
			b.TextColor3 = T.Sub
			b.Font = Enum.Font.GothamBold
			b.TextSize = 14
			b.ZIndex = 7
			b.Parent = bar
			b.MouseEnter:Connect(function()
				b.BackgroundColor3 = (txt == "×") and Color3.fromRGB(180, 40, 40) or T.Hover
				if txt == "×" then b.TextColor3 = Color3.new(1, 1, 1) end
			end)
			b.MouseLeave:Connect(function()
				b.BackgroundColor3 = T.Bar
				b.TextColor3 = T.Sub
			end)
			return b
		end

		local closeBtn = winBtn("×", -36)
		local maxBtn   = winBtn("□", -72)
		local minBtn   = winBtn("─", -108)

		local body = Instance.new("Frame")
		body.Name = "Body"
		body.Size = UDim2.new(1, 0, 1, -T.BarH)
		body.Position = UDim2.fromOffset(0, T.BarH)
		body.BackgroundColor3 = T.Bg
		body.BorderSizePixel = 0
		body.ClipsDescendants = true
		body.ZIndex = 2
		body.Parent = window

		local side = Instance.new("ScrollingFrame")
		side.Name = "Tabs"
		side.Size = UDim2.new(0, T.SideW, 1, 0)
		side.BackgroundColor3 = T.Side
		side.BorderSizePixel = 0
		side.ScrollBarThickness = 2
		side.ScrollBarImageColor3 = Color3.fromRGB(60, 60, 60)
		side.CanvasSize = UDim2.new()
		side.AutomaticCanvasSize = Enum.AutomaticSize.Y
		side.Visible = false
		side.ZIndex = 3
		side.Parent = body
		pad(side, 8, 8, 10, 10)

		local sideLayout = Instance.new("UIListLayout")
		sideLayout.Padding = UDim.new(0, 4)
		sideLayout.SortOrder = Enum.SortOrder.LayoutOrder
		sideLayout.Parent = side

		local sideLine = Instance.new("Frame")
		sideLine.BackgroundColor3 = T.Stroke
		sideLine.BorderSizePixel = 0
		sideLine.Size = UDim2.new(0, 1, 1, 0)
		sideLine.Position = UDim2.fromOffset(T.SideW, 0)
		sideLine.Visible = false
		sideLine.ZIndex = 3
		sideLine.Parent = body

		local pages = Instance.new("Frame")
		pages.Name = "Pages"
		pages.Size = UDim2.fromScale(1, 1)
		pages.BackgroundColor3 = T.Bg
		pages.BorderSizePixel = 0
		pages.ClipsDescendants = true
		pages.ZIndex = 2
		pages.Parent = body

		local emptyHint = Instance.new("TextLabel")
		emptyHint.BackgroundTransparency = 1
		emptyHint.Size = UDim2.fromScale(1, 1)
		emptyHint.Font = Enum.Font.Gotham
		emptyHint.TextSize = 13
		emptyHint.TextColor3 = T.Sub
		emptyHint.Text = ""
		emptyHint.ZIndex = 2
		emptyHint.Parent = pages

		local toastHold = Instance.new("Frame")
		toastHold.BackgroundTransparency = 1
		toastHold.Size = UDim2.new(0, 260, 1, -20)
		toastHold.Position = UDim2.new(1, -280, 0, 10)
		toastHold.ZIndex = 80
		toastHold.Parent = gui
		local toastLay = Instance.new("UIListLayout")
		toastLay.Padding = UDim.new(0, 6)
		toastLay.HorizontalAlignment = Enum.HorizontalAlignment.Right
		toastLay.Parent = toastHold

		local minimized, maximized = false, false
		local saved = { size = window.Size, pos = window.Position }
		local dragging, dragStart, startPos = false, nil, nil
		local resizing, resizeDir, resizeStart, resizeSize, resizePos = false, nil, nil, nil, nil

		local function viewport()
			return workspace.CurrentCamera.ViewportSize
		end

		bind(bar.InputBegan, function(input)
			if maximized then return end
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = window.Position
			end
		end)

		bind(UIS.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
				resizing = false
			end
		end)

		bind(UIS.InputChanged, function(input)
			if not (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				return
			end
			if dragging and not resizing and not maximized then
				local d = input.Position - dragStart
				window.Position = UDim2.fromOffset(startPos.X.Offset + d.X, startPos.Y.Offset + d.Y)
			elseif resizing and not minimized then
				local d = input.Position - resizeStart
				local w, h = resizeSize.X, resizeSize.Y
				local px, py = resizePos.X.Offset, resizePos.Y.Offset
				local dir = resizeDir
				if dir:find("E") then w = resizeSize.X + d.X end
				if dir:find("S") then h = resizeSize.Y + d.Y end
				if dir:find("W") then
					w = resizeSize.X - d.X
					px = resizePos.X.Offset + d.X
				end
				if dir:find("N") then
					h = resizeSize.Y - d.Y
					py = resizePos.Y.Offset + d.Y
				end
				w = math.max(minSize.X, w)
				h = math.max(minimized and T.BarH or minSize.Y, h)
				if dir:find("W") and w == minSize.X then
					px = resizePos.X.Offset + (resizeSize.X - minSize.X)
				end
				if dir:find("N") and h == (minimized and T.BarH or minSize.Y) then
					py = resizePos.Y.Offset + (resizeSize.Y - h)
				end
				window.Size = UDim2.fromOffset(w, h)
				window.Position = UDim2.fromOffset(px, py)
			end
		end)

		local handles = {}
		local function makeHandle(name, size, pos, dir)
			local h = Instance.new("TextButton")
			h.Name = "H_" .. name
			h.Text = ""
			h.BackgroundTransparency = 1
			h.AutoButtonColor = false
			h.Size = size
			h.Position = pos
			h.ZIndex = 20
			h.Parent = window
			handles[name] = h
			bind(h.InputBegan, function(input)
				if minimized or maximized then return end
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					resizing = true
					resizeDir = dir
					resizeStart = input.Position
					resizeSize = window.AbsoluteSize
					resizePos = window.Position
					dragging = false
				end
			end)
		end

		local HS = 8
		makeHandle("E",  UDim2.new(0, HS, 1, -HS / 2), UDim2.new(1, -HS / 2, 0, HS), "E")
		makeHandle("W",  UDim2.new(0, HS, 1, -HS / 2), UDim2.new(0, -HS / 2, 0, HS), "W")
		makeHandle("S",  UDim2.new(1, -HS / 2, 0, HS), UDim2.new(0, HS, 1, -HS / 2), "S")
		makeHandle("N",  UDim2.new(1, -HS / 2, 0, HS), UDim2.new(0, HS, 0, -HS / 2), "N")
		makeHandle("SE", UDim2.fromOffset(14, 14), UDim2.new(1, -7, 1, -7), "SE")
		makeHandle("SW", UDim2.fromOffset(14, 14), UDim2.new(0, -7, 1, -7), "SW")
		makeHandle("NE", UDim2.fromOffset(14, 14), UDim2.new(1, -7, 0, -7), "NE")
		makeHandle("NW", UDim2.fromOffset(14, 14), UDim2.new(0, -7, 0, -7), "NW")

		local function setHandles(vis)
			for _, h in pairs(handles) do
				h.Visible = vis
			end
		end

		local function setMinimized(state)
			if state == minimized then return end
			minimized = state
			if minimized then
				if not maximized then
					saved.size = window.Size
					saved.pos = window.Position
				end
				tween(window, { Size = UDim2.fromOffset(window.AbsoluteSize.X, T.BarH) })
				task.delay(0.18, function()
					if minimized then body.Visible = false end
				end)
				minBtn.Text = "▢"
				setHandles(false)
			else
				body.Visible = true
				local target = maximized and UDim2.fromOffset(viewport().X, viewport().Y) or saved.size
				tween(window, { Size = target })
				minBtn.Text = "─"
				setHandles(not maximized)
			end
		end

		local function setMaximized(state)
			if minimized then setMinimized(false) end
			maximized = state
			if maximized then
				saved.size = window.Size
				saved.pos = window.Position
				tween(window, {
					Size = UDim2.fromOffset(viewport().X, viewport().Y),
					Position = UDim2.fromOffset(0, 0),
				})
				maxBtn.Text = "❐"
				setHandles(false)
			else
				tween(window, { Size = saved.size, Position = saved.pos })
				maxBtn.Text = "□"
				setHandles(true)
			end
		end

		bind(minBtn.MouseButton1Click, function()
			setMinimized(not minimized)
		end)
		bind(maxBtn.MouseButton1Click, function()
			setMaximized(not maximized)
		end)
		bind(closeBtn.MouseButton1Click, function()
			gui.Enabled = false
		end)

		local lastClick = 0
		bind(bar.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				local now = os.clock()
				if now - lastClick < 0.28 then
					setMaximized(not maximized)
				end
				lastClick = now
			end
		end)

		local tabs = {}
		local WindowApi = {}
		local onUnload = {}

		function WindowApi:OnUnload(fn)
			table.insert(onUnload, fn)
		end

		local function showSidebar()
			if side.Visible then return end
			side.Visible = true
			sideLine.Visible = true
			emptyHint.Visible = false
			pages.Size = UDim2.new(1, -T.SideW - 1, 1, 0)
			pages.Position = UDim2.fromOffset(T.SideW + 1, 0)
		end

		local function makePage()
			local page = Instance.new("ScrollingFrame")
			page.BackgroundTransparency = 1
			page.Size = UDim2.fromScale(1, 1)
			page.BorderSizePixel = 0
			page.ScrollBarThickness = 3
			page.ScrollBarImageColor3 = Color3.fromRGB(70, 70, 70)
			page.CanvasSize = UDim2.new()
			page.AutomaticCanvasSize = Enum.AutomaticSize.Y
			page.Visible = false
			page.ZIndex = 3
			page.Parent = pages
			pad(page, 14, 14, 12, 16)
			local lay = Instance.new("UIListLayout")
			lay.Padding = UDim.new(0, 8)
			lay.SortOrder = Enum.SortOrder.LayoutOrder
			lay.Parent = page
			return page
		end

		local function widgetFrame(page, h)
			local f = Instance.new("Frame")
			f.BackgroundColor3 = T.Elem
			f.BorderSizePixel = 0
			f.Size = UDim2.new(1, 0, 0, h or 40)
			f.ZIndex = 4
			f.Parent = page
			corner(f, 6)
			stroke(f, Color3.fromRGB(26, 26, 26), 1)
			return f
		end

		local function nameLabel(parent, txt, w)
			local l = Instance.new("TextLabel")
			l.BackgroundTransparency = 1
			l.Size = UDim2.new(w or 0.55, 0, 1, 0)
			l.Position = UDim2.fromOffset(12, 0)
			l.Font = Enum.Font.GothamMedium
			l.TextSize = 13
			l.TextColor3 = T.Text
			l.TextXAlignment = Enum.TextXAlignment.Left
			l.TextTruncate = Enum.TextTruncate.AtEnd
			l.Text = txt
			l.ZIndex = 5
			l.Parent = parent
			return l
		end

		function WindowApi:Notify(text, dur)
			local f = Instance.new("TextLabel")
			f.BackgroundColor3 = Color3.fromRGB(16, 16, 16)
			f.Size = UDim2.new(1, 0, 0, 36)
			f.Font = Enum.Font.GothamMedium
			f.TextSize = 12
			f.TextColor3 = T.Text
			f.Text = "  ◆ " .. tostring(text)
			f.TextXAlignment = Enum.TextXAlignment.Left
			f.ZIndex = 81
			f.Parent = toastHold
			corner(f, 6)
			stroke(f, T.Stroke, 1)
			task.delay(dur or 2.5, function()
				tween(f, { BackgroundTransparency = 1, TextTransparency = 1 }, TweenInfo.new(0.2))
				task.wait(0.2)
				f:Destroy()
			end)
		end

		function WindowApi:Tab(tabName)
			if type(tabName) == "table" then
				tabName = tabName.Name or tabName.name or "Tab"
			end
			tabName = tabName or "Tab"
			showSidebar()

			local tabBtn = textBtn(side, {
				Text = tabName,
				Size = UDim2.new(1, 0, 0, 32),
				BackgroundColor3 = T.Side,
				Corner = 6,
				Align = Enum.TextXAlignment.Left,
			})
			tabBtn.TextColor3 = T.Sub
			pad(tabBtn, 10, 8, 0, 0)
			tabBtn.ZIndex = 4

			local indicator = Instance.new("Frame")
			indicator.BackgroundColor3 = T.Accent
			indicator.BorderSizePixel = 0
			indicator.Size = UDim2.new(0, 2, 0, 16)
			indicator.Position = UDim2.new(0, 0, 0.5, -8)
			indicator.Visible = false
			indicator.ZIndex = 5
			indicator.Parent = tabBtn

			local page = makePage()
			local tab = { Name = tabName, Button = tabBtn, Page = page, Indicator = indicator }

			local function selectTab()
				for _, t in ipairs(tabs) do
					t.Page.Visible = false
					t.Button.BackgroundColor3 = T.Side
					t.Button.TextColor3 = T.Sub
					t.Indicator.Visible = false
				end
				page.Visible = true
				tabBtn.BackgroundColor3 = T.Elem
				tabBtn.TextColor3 = T.Text
				indicator.Visible = true
			end

			bind(tabBtn.MouseButton1Click, selectTab)
			hover(tabBtn, T.Side, T.Hover)
			table.insert(tabs, tab)
			if #tabs == 1 then selectTab() end

			local TabApi = {}

			function TabApi:Label(opt)
				opt = type(opt) == "table" and opt or { Name = tostring(opt) }
				local f = widgetFrame(page, opt.Height or 28)
				f.BackgroundTransparency = 1
				local st = f:FindFirstChildOfClass("UIStroke")
				if st then st:Destroy() end
				local l = nameLabel(f, opt.Name or opt.Text or "", 1)
				l.TextColor3 = opt.Color or T.Sub
				l.Position = UDim2.fromOffset(4, 0)
				return l
			end

			function TabApi:Separator()
				local f = Instance.new("Frame")
				f.BackgroundTransparency = 1
				f.Size = UDim2.new(1, 0, 0, 10)
				f.Parent = page
				local line = Instance.new("Frame")
				line.BackgroundColor3 = T.Stroke
				line.BorderSizePixel = 0
				line.Size = UDim2.new(1, 0, 0, 1)
				line.Position = UDim2.new(0, 0, 0.5, 0)
				line.Parent = f
				return f
			end

			function TabApi:Button(opt)
				opt = opt or {}
				local f = widgetFrame(page, 40)
				local b = textBtn(f, {
					Text = opt.Name or "Button",
					Size = UDim2.new(1, -16, 1, -10),
					Position = UDim2.fromOffset(8, 5),
					BackgroundColor3 = Color3.fromRGB(24, 24, 24),
					Corner = 5,
				})
				b.ZIndex = 5
				stroke(b, Color3.fromRGB(40, 40, 40), 1)
				hover(b, Color3.fromRGB(24, 24, 24), T.Hover)
				bind(b.MouseButton1Click, function()
					tween(b, { BackgroundColor3 = T.Press }, TweenInfo.new(0.05))
					task.delay(0.08, function()
						tween(b, { BackgroundColor3 = T.Hover }, TweenInfo.new(0.12))
					end)
					runScript(opt.SCRIPT or opt.Script or opt.Callback, {})
				end)
				return b
			end

			function TabApi:Toggle(opt)
				opt = opt or {}
				local on = opt.Default == true
				local f = widgetFrame(page, 42)
				nameLabel(f, opt.Name or "Toggle", 0.7)

				local track = Instance.new("TextButton")
				track.AutoButtonColor = false
				track.Text = ""
				track.Size = UDim2.fromOffset(40, 20)
				track.Position = UDim2.new(1, -52, 0.5, -10)
				track.BackgroundColor3 = on and T.Accent or Color3.fromRGB(40, 40, 40)
				track.ZIndex = 5
				track.Parent = f
				corner(track, 10)

				local knob = Instance.new("Frame")
				knob.Size = UDim2.fromOffset(16, 16)
				knob.Position = on and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)
				knob.BackgroundColor3 = on and T.Bg or T.Text
				knob.BorderSizePixel = 0
				knob.ZIndex = 6
				knob.Parent = track
				corner(knob, 8)

				local function apply(v, fire)
					on = v
					tween(track, { BackgroundColor3 = on and T.Accent or Color3.fromRGB(40, 40, 40) })
					tween(knob, {
						Position = on and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2),
						BackgroundColor3 = on and T.Bg or T.Text,
					})
					if fire then
						runScript(opt.SCRIPT or opt.Script or opt.Callback, { Value = on })
					end
				end
				bind(track.MouseButton1Click, function() apply(not on, true) end)
				return {
					Set = function(_, v) apply(v, true) end,
					Get = function() return on end,
				}
			end

			function TabApi:Slider(opt)
				opt = opt or {}
				local minV = opt.Min or 0
				local maxV = opt.Max or 100
				local value = math.clamp(opt.Default or minV, minV, maxV)
				local decimals = opt.Decimals or opt.Rounding or ((maxV - minV) <= 10 and 1 or 0)

				local f = widgetFrame(page, 56)
				local nl = nameLabel(f, opt.Name or "Slider", 0.6)
				nl.Size = UDim2.new(0.6, 0, 0, 22)
				nl.Position = UDim2.fromOffset(12, 4)

				local valL = Instance.new("TextLabel")
				valL.BackgroundTransparency = 1
				valL.Size = UDim2.new(0.4, -12, 0, 22)
				valL.Position = UDim2.new(0.6, 0, 0, 4)
				valL.Font = Enum.Font.GothamBold
				valL.TextSize = 12
				valL.TextColor3 = T.Sub
				valL.TextXAlignment = Enum.TextXAlignment.Right
				valL.ZIndex = 5
				valL.Parent = f

				local barHold = Instance.new("Frame")
				barHold.BackgroundTransparency = 1
				barHold.Size = UDim2.new(1, -24, 0, 16)
				barHold.Position = UDim2.fromOffset(12, 30)
				barHold.ZIndex = 5
				barHold.Parent = f

				local sBar = Instance.new("Frame")
				sBar.Size = UDim2.new(1, 0, 0, 4)
				sBar.Position = UDim2.new(0, 0, 0.5, -2)
				sBar.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
				sBar.BorderSizePixel = 0
				sBar.ZIndex = 5
				sBar.Parent = barHold
				corner(sBar, 2)

				local fill = Instance.new("Frame")
				fill.BackgroundColor3 = T.Accent
				fill.BorderSizePixel = 0
				fill.ZIndex = 6
				fill.Parent = sBar
				corner(fill, 2)

				local knob = Instance.new("Frame")
				knob.Size = UDim2.fromOffset(12, 12)
				knob.AnchorPoint = Vector2.new(0.5, 0.5)
				knob.BackgroundColor3 = T.Text
				knob.BorderSizePixel = 0
				knob.ZIndex = 7
				knob.Parent = barHold
				corner(knob, 6)

				local function fmt(v)
					if decimals <= 0 then return tostring(math.floor(v + 0.5)) end
					local m = 10 ^ decimals
					return string.format("%." .. decimals .. "f", math.floor(v * m + 0.5) / m)
				end

				local function set(v, fire)
					v = math.clamp(v, minV, maxV)
					value = v
					local a = (maxV == minV) and 0 or (v - minV) / (maxV - minV)
					fill.Size = UDim2.new(a, 0, 1, 0)
					knob.Position = UDim2.new(a, 0, 0.5, 0)
					valL.Text = fmt(v)
					if fire then
						runScript(opt.SCRIPT or opt.Script or opt.Callback, { Value = v })
					end
				end
				set(value, false)

				local sliding = false
				local function fromX(x)
					local a = math.clamp((x - barHold.AbsolutePosition.X) / math.max(barHold.AbsoluteSize.X, 1), 0, 1)
					set(minV + a * (maxV - minV), true)
				end
				bind(barHold.InputBegan, function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						sliding = true
						fromX(input.Position.X)
					end
				end)
				bind(UIS.InputEnded, function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						sliding = false
					end
				end)
				bind(UIS.InputChanged, function(input)
					if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
						fromX(input.Position.X)
					end
				end)
				return { Set = function(_, v) set(v, false) end, Get = function() return value end }
			end

			function TabApi:Dropdown(opt)
				opt = opt or {}
				local options = opt.Options or opt.Values or { "1", "2", "3" }
				local multi = opt.Multi == true
				local current = opt.Default or options[1]
				local selected = {}
				if multi then
					if type(opt.Default) == "table" then
						if opt.Default[1] ~= nil then
							for _, n in ipairs(opt.Default) do selected[tostring(n)] = true end
						else
							for k, v in pairs(opt.Default) do
								if v then selected[tostring(k)] = true end
							end
						end
					end
				end

				local f = widgetFrame(page, 42)
				nameLabel(f, opt.Name or opt.Text or "Dropdown", 0.45)

				local function boxText()
					if not multi then
						return " " .. tostring(current) .. "  ▾"
					end
					local n, acc = 0, {}
					for k, v in pairs(selected) do
						if v then
							n = n + 1
							table.insert(acc, k)
						end
					end
					if n == 0 then return "  none   ▾" end
					if n <= 2 then return " " .. table.concat(acc, ", ") .. "  ▾" end
					return " " .. n .. " selected   ▾"
				end

				local box = textBtn(f, {
					Text = boxText(),
					Size = UDim2.new(0.5, -16, 0, 26),
					Position = UDim2.new(0.5, 4, 0.5, -13),
					BackgroundColor3 = Color3.fromRGB(24, 24, 24),
					Corner = 5,
					Align = Enum.TextXAlignment.Left,
				})
				box.ZIndex = 6
				stroke(box, Color3.fromRGB(42, 42, 42), 1)
				hover(box, Color3.fromRGB(24, 24, 24), T.Hover)

				local list = Instance.new("ScrollingFrame")
				list.Visible = false
				list.BackgroundColor3 = Color3.fromRGB(16, 16, 16)
				list.BorderSizePixel = 0
				list.ZIndex = 50
				list.ScrollBarThickness = 3
				list.ScrollBarImageColor3 = Color3.fromRGB(70, 70, 70)
				list.CanvasSize = UDim2.new()
				list.AutomaticCanvasSize = Enum.AutomaticSize.Y
				list.Parent = gui
				corner(list, 6)
				stroke(list, T.Stroke, 1)

				local ll = Instance.new("UIListLayout")
				ll.SortOrder = Enum.SortOrder.LayoutOrder
				ll.Parent = list
				pad(list, 4, 4, 4, 4)

				local function layoutList()
					local abs = box.AbsolutePosition
					local sz = box.AbsoluteSize
					local h = math.min(#options * 26 + 8, 180)
					list.Position = UDim2.fromOffset(abs.X, abs.Y + sz.Y + 4)
					list.Size = UDim2.fromOffset(math.max(sz.X, 140), h)
				end

				local function fire()
					if multi then
						runScript(opt.SCRIPT or opt.Script or opt.Callback, { Value = selected })
					else
						runScript(opt.SCRIPT or opt.Script or opt.Callback, { Value = current })
					end
				end

				local function set(v, fireNow)
					if multi then
						if type(v) == "table" then selected = v end
					else
						current = v
					end
					box.Text = boxText()
					if fireNow then fire() end
				end

				for i, optName in ipairs(options) do
					local ob = textBtn(list, {
						Text = "  " .. tostring(optName),
						Size = UDim2.new(1, 0, 0, 24),
						BackgroundColor3 = Color3.fromRGB(16, 16, 16),
						Corner = 4,
						Align = Enum.TextXAlignment.Left,
					})
					ob.ZIndex = 51
					ob.LayoutOrder = i
					hover(ob, Color3.fromRGB(16, 16, 16), T.Hover)
					bind(ob.MouseButton1Click, function()
						if multi then
							selected[optName] = not selected[optName]
							box.Text = boxText()
							fire()
						else
							set(optName, true)
							list.Visible = false
						end
					end)
				end

				bind(box.MouseButton1Click, function()
					layoutList()
					list.Visible = not list.Visible
				end)
				bind(RunService.RenderStepped, function()
					if list.Visible then layoutList() end
				end)
				return {
					Set = function(_, v) set(v, false) end,
					Get = function()
						if multi then return selected end
						return current
					end,
				}
			end

			function TabApi:TextBox(opt)
				opt = opt or {}
