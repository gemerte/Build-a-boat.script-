			function TabApi:ColorPicker(opt)
				opt = opt or {}
				local col = opt.Default or Color3.fromRGB(255, 255, 255)
				local f = widgetFrame(page, 42)
				nameLabel(f, opt.Name or "Color", 0.55)

				local sw = Instance.new("TextButton")
				sw.AutoButtonColor = false
				sw.Text = ""
				sw.Size = UDim2.fromOffset(48, 22)
				sw.Position = UDim2.new(1, -60, 0.5, -11)
				sw.BackgroundColor3 = col
				sw.ZIndex = 6
				sw.Parent = f
				corner(sw, 4)
				stroke(sw, Color3.fromRGB(50, 50, 50), 1)

				local pop = Instance.new("Frame")
				pop.Visible = false
				pop.BackgroundColor3 = Color3.fromRGB(16, 16, 16)
				pop.BorderSizePixel = 0
				pop.ZIndex = 55
				pop.Size = UDim2.fromOffset(180, 92)
				pop.Parent = gui
				corner(pop, 6)
				stroke(pop, T.Stroke, 1)
				pad(pop, 8, 8, 8, 8)

				local function mkRow(y, label, channel)
					local l = Instance.new("TextLabel")
					l.BackgroundTransparency = 1
					l.Size = UDim2.new(0, 14, 0, 16)
					l.Position = UDim2.fromOffset(0, y)
					l.Font = Enum.Font.GothamBold
					l.TextSize = 11
					l.TextColor3 = T.Sub
					l.Text = label
					l.ZIndex = 56
					l.Parent = pop
					local hold = Instance.new("TextButton")
					hold.AutoButtonColor = false
					hold.Text = ""
					hold.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
					hold.Size = UDim2.new(1, -18, 0, 8)
					hold.Position = UDim2.fromOffset(18, y + 4)
					hold.ZIndex = 56
					hold.Parent = pop
					corner(hold, 3)
					local fill = Instance.new("Frame")
					fill.BorderSizePixel = 0
					fill.BackgroundColor3 = T.Accent
					fill.Size = UDim2.new(channel, 0, 1, 0)
					fill.ZIndex = 57
					fill.Parent = hold
					corner(fill, 3)
					return hold, fill
				end

				local rH, rF = mkRow(0, "R", col.R)
				local gH, gF = mkRow(24, "G", col.G)
				local bH, bF = mkRow(48, "B", col.B)

				local function apply(c, fire)
					col = c
					sw.BackgroundColor3 = col
					rF.Size = UDim2.new(col.R, 0, 1, 0)
					gF.Size = UDim2.new(col.G, 0, 1, 0)
					bF.Size = UDim2.new(col.B, 0, 1, 0)
					if fire then
						runScript(opt.SCRIPT or opt.Script or opt.Callback, { Value = col })
					end
				end

				local function bindChan(hold, chan)
					local sliding = false
					local function fromX(x)
						local a = math.clamp((x - hold.AbsolutePosition.X) / math.max(hold.AbsoluteSize.X, 1), 0, 1)
						local r, g, b = col.R, col.G, col.B
						if chan == "R" then r = a elseif chan == "G" then g = a else b = a end
						apply(Color3.new(r, g, b), true)
					end
					bind(hold.InputBegan, function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 then
							sliding = true
							fromX(input.Position.X)
						end
					end)
					bind(UIS.InputEnded, function(input)
						if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
					end)
					bind(UIS.InputChanged, function(input)
						if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
							fromX(input.Position.X)
						end
					end)
				end
				bindChan(rH, "R")
				bindChan(gH, "G")
				bindChan(bH, "B")

				bind(sw.MouseButton1Click, function()
					local abs = sw.AbsolutePosition
					pop.Position = UDim2.fromOffset(abs.X - 132, abs.Y + 26)
					pop.Visible = not pop.Visible
				end)
				bind(RunService.RenderStepped, function()
					if pop.Visible then
						local abs = sw.AbsolutePosition
						pop.Position = UDim2.fromOffset(abs.X - 132, abs.Y + 26)
					end
				end)

				return { Set = function(_, v) apply(v, false) end, Get = function() return col end }
			end

