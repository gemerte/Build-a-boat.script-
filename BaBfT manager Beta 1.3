-- ===================== SMART FARM SYSTEM =====================
local FarmSystem = {
    Enabled = false,
    Mode = "Stages",
    StageDelay = 1.2,
    MoveSpeed = 70,
    CollectRadius = 45,
    HeightOffset = 8,
    LookAhead = true,
    AutoRebuild = false,
    CurrentStage = 0,
    TotalStages = 0,
    Status = "Idle",
    Stages = {},
}

local function Farm_ScanStages()
    local stages = {}
    local seen = {}

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Size.Magnitude > 5 then
            local n = obj.Name:lower()
            if n:find("stage") or n:find("checkpoint") or n:find("island")
                or n:find("platform") or n:find("block") or n:find("land") then
                local key = string.format("%.0f_%.0f", obj.Position.X / 20, obj.Position.Z / 20)
                if not seen[key] then
                    seen[key] = true
                    table.insert(stages, {
                        Part = obj,
                        Pos = obj.Position + Vector3.new(0, FarmSystem.HeightOffset, 0),
                        Z = obj.Position.Z,
                        Name = obj.Name,
                    })
                end
            end
        end
    end

    if #stages < 5 then
        stages = {}
        local startZ = 0
        local endZ = 4000
        local step = 80
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        local baseX = hrp and hrp.Position.X or 0
        local baseY = (hrp and hrp.Position.Y or 20) + FarmSystem.HeightOffset

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local n = obj.Name:lower()
                if n:find("end") or n:find("finish") or n:find("goal") or n:find("treasure") then
                    if obj.Position.Z > endZ then endZ = obj.Position.Z + 50 end
                end
                if obj.Position.Z > endZ then endZ = obj.Position.Z end
            end
        end

        for z = startZ, endZ, step do
            table.insert(stages, {
                Part = nil,
                Pos = Vector3.new(baseX, baseY, z),
                Z = z,
                Name = "Waypoint_" .. tostring(math.floor(z)),
            })
        end
    end

    table.sort(stages, function(a, b) return a.Z < b.Z end)

    local cleaned = {}
    local lastZ = -99999
    for _, s in ipairs(stages) do
        if s.Z - lastZ >= 40 then
            table.insert(cleaned, s)
            lastZ = s.Z
        end
    end

    FarmSystem.Stages = cleaned
    FarmSystem.TotalStages = #cleaned
    FarmSystem.CurrentStage = 0
    return cleaned
end

local function Farm_TweenTo(targetPos, duration)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    duration = duration or math.clamp((hrp.Position - targetPos).Magnitude / FarmSystem.MoveSpeed, 0.4, 4)

    if FarmSystem.LookAhead then
        local look = CFrame.lookAt(hrp.Position, Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z))
        hrp.CFrame = CFrame.new(hrp.Position) * (look - look.Position)
    end

    local tween = TweenService:Create(hrp, TweenInfo.new(
        duration,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.InOut
    ), {
        CFrame = CFrame.new(targetPos)
    })

    local wasAnchored = hrp.Anchored
    hrp.Anchored = true
    tween:Play()
    tween.Completed:Wait()
    hrp.Anchored = wasAnchored
    return true
end

local function Farm_CollectNearby()
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return 0 end

    local collected = 0
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("gold") or n:find("coin") or n:find("treasure") or n:find("reward") or n:find("gem") then
                local dist = (obj.Position - hrp.Position).Magnitude
                if dist <= FarmSystem.CollectRadius then
                    if dist > 8 then
                        local mid = hrp.Position:Lerp(obj.Position + Vector3.new(0, 3, 0), 0.7)
                        Farm_TweenTo(mid, 0.35)
                    end
                    pcall(function()
                        firetouchinterest(hrp, obj, 0)
                        task.wait(0.05)
                        firetouchinterest(hrp, obj, 1)
                    end)
                    pcall(function()
                        if obj.Parent and obj.Parent:IsA("Tool") then
                            obj.Parent.Parent = player.Backpack
                        end
                    end)
                    collected = collected + 1
                    task.wait(0.08)
                end
            end
        end
    end
    return collected
end

local function Farm_DoStage(index)
    local stage = FarmSystem.Stages[index]
    if not stage then return false end

    FarmSystem.CurrentStage = index
    FarmSystem.Status = string.format("Stage %d/%d — %s", index, FarmSystem.TotalStages, stage.Name)

    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        local origin = Vector3.new(stage.Pos.X, stage.Pos.Y + 50, stage.Pos.Z)
        local ray = workspace:Raycast(origin, Vector3.new(0, -200, 0))
        if ray then
            stage.Pos = Vector3.new(stage.Pos.X, ray.Position.Y + FarmSystem.HeightOffset, stage.Pos.Z)
        end
    end

    Farm_TweenTo(stage.Pos)
    task.wait(0.15)
    local got = Farm_CollectNearby()
    FarmSystem.Status = string.format("Stage %d/%d | +%d gold", index, FarmSystem.TotalStages, got)
    task.wait(FarmSystem.StageDelay)
    return true
end

local function Farm_GoFinish()
    FarmSystem.Status = "Going to finish..."
    local best, maxZ = nil, -math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("end") or n:find("finish") or n:find("goal") or n:find("treasure") then
                if obj.Position.Z > maxZ then
                    maxZ = obj.Position.Z
                    best = obj
                end
            end
        end
    end
    if best then
        Farm_TweenTo(best.Position + Vector3.new(0, FarmSystem.HeightOffset, 0), 1.5)
        Farm_CollectNearby()
        FarmSystem.Status = "Finish reached!"
        Library:Notify("Финиш! Золото собрано", 3)
        return true
    end
    if #FarmSystem.Stages > 0 then
        local last = FarmSystem.Stages[#FarmSystem.Stages]
        Farm_TweenTo(last.Pos + Vector3.new(0, 0, 100), 1.5)
        FarmSystem.Status = "End of path"
    end
    return false
end

local function Farm_Stop()
    FarmSystem.Enabled = false
    FarmSystem.Status = "Stopped"
end

local function Farm_Start()
    if FarmSystem.Enabled then return end
    FarmSystem.Enabled = true
    FarmSystem.Status = "Scanning map..."

    local stages = Farm_ScanStages()
    if #stages == 0 then
        FarmSystem.Status = "No stages found"
        FarmSystem.Enabled = false
        Library:Notify("Этапы не найдены", 3)
        return
    end

    Library:Notify(string.format("Найдено %d точек. Старт!", #stages), 3)
    FarmSystem.Status = string.format("Running 0/%d", #stages)

    task.spawn(function()
        while FarmSystem.Enabled do
            if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
                FarmSystem.Status = "Waiting respawn..."
                player.CharacterAdded:Wait()
                task.wait(1.5)
            end

            for i = 1, #FarmSystem.Stages do
                if not FarmSystem.Enabled then break end
                pcall(function() Farm_DoStage(i) end)
            end

            if not FarmSystem.Enabled then break end

            pcall(Farm_GoFinish)
            task.wait(1)

            if FarmSystem.AutoRebuild then
                FarmSystem.Status = "Rebuilding..."
                local hum = player.Character and player.Character:FindFirstChild("Humanoid")
                if hum then hum.Health = 0 end
                player.CharacterAdded:Wait()
                task.wait(2)
                Farm_ScanStages()
            else
                FarmSystem.Status = "Done!"
                FarmSystem.Enabled = false
                if Toggles.SmartFarm then pcall(function() Toggles.SmartFarm:SetValue(false) end) end
                break
            end
        end
        if not FarmSystem.Enabled then FarmSystem.Status = "Idle" end
    end)
end

local function Farm_StartSmooth()
    if FarmSystem.Enabled then return end
    FarmSystem.Enabled = true
    FarmSystem.Status = "Smooth farm..."

    task.spawn(function()
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then FarmSystem.Enabled = false return end

        local startZ = hrp.Position.Z
        local targetZ = startZ + 5000
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local n = obj.Name:lower()
                if (n:find("end") or n:find("finish")) and obj.Position.Z > targetZ then
                    targetZ = obj.Position.Z + 30
                end
            end
        end

        local z = startZ
        local step = 25
        while FarmSystem.Enabled and z < targetZ do
            hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then
                player.CharacterAdded:Wait()
                task.wait(1)
                hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            end
            if not hrp then break end

            z = z + step
            local pos = Vector3.new(hrp.Position.X, hrp.Position.Y, z)
            local ray = workspace:Raycast(Vector3.new(pos.X, pos.Y + 80, pos.Z), Vector3.new(0, -250, 0))
            if ray then
                pos = Vector3.new(pos.X, ray.Position.Y + FarmSystem.HeightOffset, pos.Z)
            end

            Farm_TweenTo(pos, step / FarmSystem.MoveSpeed)
            Farm_CollectNearby()
            FarmSystem.Status = string.format("Smooth Z=%.0f / %.0f", z, targetZ)
            task.wait(0.05)
        end

        if FarmSystem.Enabled then
            pcall(Farm_GoFinish)
            if FarmSystem.AutoRebuild then
                local hum = player.Character and player.Character:FindFirstChild("Humanoid")
                if hum then hum.Health = 0 end
                player.CharacterAdded:Wait()
                task.wait(2)
                FarmSystem.Enabled = false
                Farm_StartSmooth()
                return
            end
        end
        FarmSystem.Enabled = false
        FarmSystem.Status = "Idle"
        if Toggles.SmartFarm then pcall(function() Toggles.SmartFarm:SetValue(false) end) end
    end)
end

